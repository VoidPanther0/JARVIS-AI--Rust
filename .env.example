# Copy to .env and adjust. Never commit a real .env file.

# development | production
JARVIS_ENV=development

# Overrides the OS-default application data directory.
# JARVIS_DATA_DIR=C:\Users\you\AppData\Roaming\JARVIS

# trace | debug | info | warn | error
JARVIS_LOG_LEVEL=info

# Name of the registered AI provider to use. "null" (default) is a
# placeholder that returns a fixed message; no real provider ships yet.
JARVIS_AI_PROVIDER=null
